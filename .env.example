# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# --- LLM ---
OPENAI_API_KEY=placeholder

# --- Postgres (docker compose + backend) ---
POSTGRES_USER=txlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=txlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://txlens:change-me@localhost:5432/txlens

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233

# --- Langfuse (local v2, shares Postgres; database "langfuse") ---
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_NEXTAUTH_SECRET=placeholder-generate-with-openssl-rand-base64-32
LANGFUSE_SALT=placeholder-generate-with-openssl-rand-base64-32
# Create these in the Langfuse UI (Settings -> API keys) after first login.
LANGFUSE_PUBLIC_KEY=placeholder
LANGFUSE_SECRET_KEY=placeholder
