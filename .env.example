# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# --- Document OCR: tesseract (default) or docling (`uv sync --all-packages --group docling`) ---
OCR_ENGINE=tesseract
# Where document source paths (pathology/<center>/<file>.pdf) are found, for page images.
DOCUMENTS_ROOT=data/raw

# --- LLM ---
OPENAI_API_KEY=placeholder
# LiteLLM model name. Free local alternative: ollama/llama3.1:8b (needs `ollama serve`).
LLM_MODEL=openai/gpt-6-luna
# Second extraction pass; empty = same model with a different prompt.
LLM_MODEL_PASS_B=
LLM_REASONING_EFFORT=low
# Hard spending cap per batch, in US dollars. The batch stops when it is reached.
LLM_BUDGET_USD=3
LLM_CONCURRENCY=4
# Copilot literature embeddings: openai/text-embedding-3-small (768 dims) or ollama/nomic-embed-text
EMBEDDING_MODEL=openai/text-embedding-3-small
# Judge of the copilot evaluation (RAGAS, citation checks): another model than LLM_MODEL
EVAL_JUDGE_MODEL=openai/gpt-5.6-luna
# PubMed E-utilities (`make literature-download`): NCBI asks every client for a contact email;
# an API key (optional, free from your NCBI account) raises the limit from 3 to 10 requests/s.
NCBI_EMAIL=you@example.org
NCBI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Document confidence below this goes to human review; unanswered reviews expire after N days.
REVIEW_THRESHOLD=0.70
# Share of would-be auto-approved reports reviewed anyway ("QC sample"), to keep measuring errors.
QC_SAMPLE_RATE=0.10
REVIEW_TIMEOUT_DAYS=14

# --- Postgres (docker compose + backend) ---
POSTGRES_USER=txlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=txlens
POSTGRES_PORT=5432
# Owner role (migrations only).
DATABASE_URL=postgresql+psycopg://txlens:change-me@localhost:5432/txlens
# App login role, created by `make db-setup`; Row-Level Security applies to it.
APP_DATABASE_URL=postgresql+psycopg://txlens_api:change-me-too@localhost:5432/txlens

# --- API auth and de-identification (generate each with: openssl rand -base64 48) ---
JWT_SECRET=placeholder-generate-with-openssl-rand-base64-48
DEID_HMAC_KEY=placeholder-generate-with-openssl-rand-base64-48
# Differencing guard: a count is withheld if, with one shown to the same user within this many
# days over nested filters, it would reveal fewer than 11 patients.
DISCLOSURE_WINDOW_DAYS=30

# --- Rejection-risk model: MLflow tracking + registry (`make risk-train`, `make mlflow-ui`) ---
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
# Browsers accept Secure cookies on http://localhost; set false only for plain-http hosts.
COOKIE_SECURE=true
FRONTEND_ORIGIN=http://localhost:3000
# Browser path of /auth behind the frontend's /api proxy (default); "/auth" for direct API use.
REFRESH_COOKIE_PATH=/api/auth
# Only these addresses may set X-Forwarded-For (the local Next.js server). Never "*".
TRUSTED_PROXY_IPS=127.0.0.1
# Demo user passwords for `make seed-users` (at least 12 characters each).
DEMO_CLINICIAN_PASSWORD=placeholder-change-me
DEMO_RESEARCHER_PASSWORD=placeholder-change-me
DEMO_DATA_STEWARD_PASSWORD=placeholder-change-me
DEMO_ADMIN_PASSWORD=placeholder-change-me

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
# Last day of the data (the synthetic extract date, data/raw/extract.json). When set,
# surveillance runs without a date (and the nightly schedule) run as of this day, and later
# dates are refused. The cloud demo sets it; leave it unset to run as of today.
# DATA_CUTOFF=2026-09-30

# --- Langfuse (local v2, shares Postgres; database "langfuse") ---
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_NEXTAUTH_SECRET=placeholder-generate-with-openssl-rand-base64-32
LANGFUSE_SALT=placeholder-generate-with-openssl-rand-base64-32
# Create these in the Langfuse UI (Settings -> API keys) after first login.
LANGFUSE_PUBLIC_KEY=placeholder
LANGFUSE_SECRET_KEY=placeholder
